# LICENSELAND — environment template
# Every value below is UNSET on purpose. No fake defaults are shipped.
# Features whose variables are missing MUST stay disabled by their feature flag.

# ---------- Core ----------
NODE_ENV=development
APP_BASE_URL=
BRAND_NAME=
PRIMARY_LOCALE=fa-IR
SECONDARY_LOCALE=
DISPLAY_TIMEZONE=Asia/Tehran

# ---------- Database ----------
# ADR-0002: PostgreSQL is the production recommendation (and the default in
# prisma/schema.prisma). The schema `provider = "postgresql"`.
#
# Connection string format:
#   postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public&sslmode=require
#
# Local dev fallback (SQLite):
#   1. Change provider to "sqlite" in prisma/schema.prisma
#   2. DATABASE_URL=file:./dev.db
DB_TARGET=postgres
DATABASE_URL=postgresql://licenseland:changeme@localhost:5432/licenseland?schema=public

# Used by docker-compose for the postgres container
POSTGRES_DB=licenseland
POSTGRES_USER=licenseland
POSTGRES_PASSWORD=changeme

# Domain (for canonical URLs + Caddy TLS)
DOMAIN=licenseland.ir
ACME_EMAIL=admin@licenseland.ir

# ---------- Supplier (irMarket Buyer API) ----------
# Server-side only. Never expose with a NEXT_PUBLIC_ prefix.
SUPPLIER_API_BASE=https://api.irmarket.store
SUPPLIER_API_KEY=
SUPPLIER_TIMEOUT_MS=8000
SUPPLIER_MAX_ATTEMPTS=3
SUPPLIER_WEBHOOK_SECRET=
# Dual-secret window for rotation (optional, accepted alongside the primary).
SUPPLIER_WEBHOOK_SECRET_PREVIOUS=
FEATURE_SUPPLIER_LIVE=false

# ---------- Pricing engine ----------
# Money is stored as integers in minor units. Confirm the Toman minor scale first.
CURRENCY=IRT
GLOBAL_MARKUP_BPS=
MIN_MARGIN_ABS_MINOR=
PRICE_FLOOR_MINOR=
PRICE_CAP_MINOR=
TAX_BPS=0
ROUNDING_MODE=
ROUNDING_UNIT_MINOR=
ROUNDING_PSYCHOLOGICAL_ENDING_MINOR=

# ---------- FX (supplier bills USD, shop sells IRT) ----------
FX_SOURCE=
FX_MAX_AGE_SECONDS=900
FX_BUFFER_BPS=
FEATURE_FX_AUTO_REFRESH=false

# ---------- Iranian payment gateway ----------
IR_GATEWAY=
MERCHANT_ID=
GATEWAY_CALLBACK_URL=
FEATURE_IR_GATEWAY=false

# ---------- Crypto rail (USDT-TRC20) ----------
CRYPTO_PROVIDER=
CRYPTO_WALLET_ADDRESS=
CRYPTO_MIN_CONFIRMATIONS=
CRYPTO_INVOICE_TTL_SECONDS=1800
FEATURE_CRYPTO_RAIL=false

# ---------- Wallet ----------
FEATURE_WALLET=true

# ---------- License vault ----------
# 32-byte key, base64 encoded. Losing it makes every stored license unrecoverable.
LICENSE_VAULT_KEY=
LICENSE_VAULT_KEY_VERSION=1

# ---------- Auth / admin ----------
NEXTAUTH_SECRET=
ADMIN_BOOTSTRAP_EMAIL=
FEATURE_ADMIN_2FA_REQUIRED=true
SESSION_MAX_AGE_SECONDS=43200

# ---------- Email ----------
SMTP_URL=
MAIL_FROM=

# ---------- Observability ----------
LOG_LEVEL=info
ERROR_MONITOR_DSN=

# ---------- SEO ----------
PUBLIC_DOMAIN=
SEO_TARGET_KEYWORDS=
FEATURE_STRUCTURED_DATA_RATING=false

# ---------- Legacy compatibility (used by current code) ----------
ZARINPAL_MERCHANT=
ZARINPAL_SANDBOX=true
SUPPLIER_API_URL=https://api.irmarket.store
SUPPLIER_MARKUP_PERCENT=200
TELEGRAM_BOT_TOKEN=
TELEGRAM_SUPPLIER_CHAT_ID=
