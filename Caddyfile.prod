# ===========================================================================
# LicenseLand — production Caddyfile
# TLS termination (automatic HTTPS via Let's Encrypt) + reverse proxy to app.
# ===========================================================================

{
    email {$ACME_EMAIL}
}

{$DOMAIN} {
    reverse_proxy app:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    encode gzip zstd

    header {
        # Security headers
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options SAMEORIGIN
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        # Remove Caddy version banner
        -Server
    }

    # Static assets cache
    @static {
        path /_next/static/* /favicon.ico /robots.txt /sitemap.xml
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Compress responses
    @compress {
        header Content-Type application/json text/* image/svg+xml
    }

    # Logging
    log {
        output file /data/access.log {
            roll_size 50mb
            roll_keep 10
            roll_keep_for 168h
        }
        format console
    }
}

# HTTP → HTTPS redirect (Caddy does this automatically but be explicit)
http://{$DOMAIN} {
    redir https://{$DOMAIN}{uri} permanent
}
